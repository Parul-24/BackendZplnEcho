    "firebase": "^9.9.0",
    "firebase-admin": "^11.0.0",
    "firebase-functions": "^3.22.0",
    "firebase-tools": "^11.2.1",
    "objects-to-csv": "^1.3.6"
  },
  "devDependencies": {
    "firebase-functions-test": "^0.2.0",
    "tslint": "^5.20.1",
    "typescript": "^3.8.0"
